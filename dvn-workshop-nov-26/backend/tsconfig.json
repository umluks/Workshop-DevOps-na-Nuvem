{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "aws-lambda"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["lambda-controller/**/*.ts", "lambda-generator/**/*.ts", "lambda-processor/**/*.ts", "shared/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
