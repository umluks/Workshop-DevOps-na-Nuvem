# Referência para Lambda → Configuration → Environment variables.
# Substitua os valores de exemplo pelos recursos do seu ambiente.

# Nome da tabela DynamoDB compartilhada pelas três Lambdas.
TABLE=nome-da-tabela

# Nome ou ARN da Lambda geradora que inicia os workers.
GENERATOR=nome-da-lambda-geradora

# URLs das filas FIFO consultadas para montar o relatório do teste.
QUEUE=https://sqs.us-east-1.amazonaws.com/000000000000/pedidos.fifo
DLQ=https://sqs.us-east-1.amazonaws.com/000000000000/pedidos-dlq.fifo
