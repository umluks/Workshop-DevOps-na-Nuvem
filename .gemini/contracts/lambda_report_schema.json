{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LambdaExecutionReport",
  "description": "Contrato de métricas do log REPORT de execução do AWS Lambda para análise automatizada.",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "billedDurationMs": {
      "type": "integer",
      "minimum": 1
    },
    "memorySizeMb": {
      "type": "integer",
      "minimum": 128
    },
    "maxMemoryUsedMb": {
      "type": "integer",
      "minimum": 1
    },
    "initDurationMs": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": ["requestId", "durationMs", "billedDurationMs", "memorySizeMb", "maxMemoryUsedMb"]
}
